{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cape-fear-accounting-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "DEV_AUTH": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cape-fear-accounting-staging",
      "database_id": "REPLACE_WITH_NEW_STAGING_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "cape-fear-accounting-staging"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
